{
  "name": "nglens",
  "version": "1.0.0",
  "type": "module",
  "description": "Visual Component & Signals Graph, Architecture Map & Health Auditor for Modern Angular Applications",
  "bin": {
    "nglens": "./bin/nglens.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "node scripts/build-ui.js",
    "watch": "tsc -w",
    "start": "node bin/nglens.js",
    "demo": "node bin/nglens.js demo",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "angular",
    "signals",
    "ast",
    "graph",
    "visualization",
    "component-tree",
    "architecture",
    "analyzer",
    "vscode-extension",
    "devtools"
  ],
  "author": "Pratik",
  "license": "MIT",
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^4.1.0",
    "dagre": "^0.8.5",
    "open": "^10.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.146.0",
    "esbuild": "^0.24.0"
  }
}
